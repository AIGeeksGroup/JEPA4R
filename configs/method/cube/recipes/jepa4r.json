{
  "output_model_name": "jepa4r",
  "subdir": "jepa4r",
  "num_workers": 2,
  "validation_num_workers": 2,
  "seed": 0,
  "fresh_seed": 0,
  "img_size": 224,
  "embed_dim": 192,
  "pcd_in_dim": 6,
  "history_size": 3,
  "trainer": {
    "max_epochs": 10,
    "devices": 1,
    "accelerator": "gpu",
    "precision": "bf16-mixed",
    "gradient_clip_val": 1.0
  },
  "loader": {
    "batch_size": 128,
    "num_workers": 2,
    "persistent_workers": false,
    "prefetch_factor": 2,
    "pin_memory": true
  },
  "optimizer": {
    "type": "AdamW",
    "lr": 5e-05,
    "weight_decay": 0.001
  },
  "num_preds": 1,
  "loss": {
    "sigreg": {
      "weight": 0.09,
      "kwargs": {
        "knots": 17,
        "num_proj": 1024
      }
    }
  },
  "wandb": {
    "enabled": false
  },
  "data": {
    "preprocessor": {
      "_target_": "jepa4r.data.clips.get_pcd_preprocessor",
      "source_xyz": "pcd_xyz",
      "source_rgb": "pcd_rgb",
      "target": "pcd",
      "center": [
        0.425,
        0.0,
        0.2
      ],
      "scale": 4.0,
      "use_rgb": true
    }
  },
  "model": {
    "encoder": {
      "_target_": "jepa4r.models.encoders.pointnet.DexArtPointNet",
      "in_dim": 6,
      "mlp_spec": [
        1080,
        4320
      ],
      "out_dim": 192,
      "chunk_points": 1200
    },
    "_target_": "jepa4r.models.world_model.JEPA",
    "obs_key": "pcd",
    "predictor": {
      "_target_": "jepa4r.models.predictor.ARPredictor",
      "num_frames": 3,
      "input_dim": 192,
      "hidden_dim": 192,
      "output_dim": 192,
      "depth": 6,
      "heads": 16,
      "mlp_dim": 2048,
      "dim_head": 64,
      "dropout": 0.1,
      "emb_dropout": 0.0
    },
    "action_encoder": {
      "_target_": "jepa4r.models.heads.Embedder",
      "input_dim": 25,
      "emb_dim": 192
    },
    "projector": {
      "_target_": "jepa4r.models.heads.MLP",
      "input_dim": 192,
      "output_dim": 192,
      "hidden_dim": 2048,
      "norm_fn": {
        "_target_": "torch.nn.BatchNorm1d",
        "_partial_": true
      }
    },
    "pred_proj": {
      "_target_": "jepa4r.models.heads.MLP",
      "input_dim": 192,
      "output_dim": 192,
      "hidden_dim": 2048,
      "norm_fn": {
        "_target_": "torch.nn.BatchNorm1d",
        "_partial_": true
      }
    }
  }
}
