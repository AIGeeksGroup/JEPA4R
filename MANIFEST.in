include README.md LICENSE
recursive-include configs *.yaml
recursive-include experiments *.yaml
recursive-include paper *.yaml *.py
recursive-include docs *.md
recursive-include scripts *.py *.sh
recursive-include tests *.py
prune checkpoints
prune outputs
prune data
prune .venv
prune .git
prune .codex
prune .agents
global-exclude *.py[cod] .DS_Store .env *.pt *.pth *.ckpt *.bin *.safetensors *.pem *.key
