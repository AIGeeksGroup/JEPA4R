<mujoco model="rm75b">
  <!--
    RealMan RM75-B, 7-DoF, written as an edit of OGBench's universal_robots_ur5e/ur5e.xml (MuJoCo Menagerie UR5e):
    same compiler / option / default-class / material / actuator layout and names; the robot data (link frames,
    inertials, meshes, joint ranges, torque limits) are replaced by the vendor URDF's
    (github.com/RealManRobot/rm_models, RM75/urdf/RM75-B). Material names are the UR5e ones (OGBench's pixel code
    looks them up); their colours are the RM75's. Collision geoms are the convex hulls of the link meshes.
  -->
  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <option integrator="implicitfast"/>

  <default>
    <default class="rm75b">
      <material specular="0.5" shininess="0.25"/>
      <joint axis="0 0 1" armature="0.1"/>
      <general gaintype="fixed" biastype="affine" gainprm="4500" biasprm="0 -4500 -400" forcerange="-60 60"/>
      <default class="size3">
        <default class="size3_limited">
          <general forcerange="-30 30"/>
        </default>
      </default>
      <default class="size1">
        <general gainprm="2000" biasprm="0 -2000 -100" forcerange="-10 10"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom type="mesh" group="3"/>
      </default>
      <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
    </default>
  </default>

  <asset>
    <material class="rm75b" name="black" rgba="0.033 0.033 0.033 1"/>
    <material class="rm75b" name="jointgray" rgba="0.6 0.6 0.62 1"/>
    <material class="rm75b" name="linkgray" rgba="0.9 0.9 0.9 1"/>
    <material class="rm75b" name="lightblue" rgba="0.6 0.72 0.94 1"/>

    <mesh file="base_link.stl"/>
    <mesh file="link_1.stl"/>
    <mesh file="link_2.stl"/>
    <mesh file="link_3.stl"/>
    <mesh file="link_4.stl"/>
    <mesh file="link_5.stl"/>
    <mesh file="link_6.stl"/>
    <mesh file="link_7.stl"/>
  </asset>

  <worldbody>
    <body name="base_link" childclass="rm75b">
      <inertial pos="0.00049987 5.2709e-05 0.060019" mass="1.862"
        fullinertia="0.0017232 0.0017051 0.00090158 -3.1058e-06 -3.7924e-05 1.3691e-06"/>
      <geom mesh="base_link" material="jointgray" class="visual"/>
      <geom mesh="base_link" class="collision"/>
      <body name="link_1" pos="0 0 0.2405">
        <inertial pos="0.000241 -0.013273 -0.00995" mass="1.574"
          fullinertia="0.002487573 0.002321038 0.001450554 9.663e-06 -7.909e-06 0.000179393"/>
        <joint name="joint_1" range="-3.106 3.106"/>
        <geom mesh="link_1" material="linkgray" class="visual"/>
        <geom mesh="link_1" class="collision"/>
        <body name="link_2" quat="0.70710678 -0.70710678 0 0">
          <inertial pos="-0.000357 -0.106789 0.005329" mass="1.217"
            fullinertia="0.003494121 0.000892721 0.00344408 2.921e-06 -5.613e-06 -0.000583884"/>
          <joint name="joint_2" range="-2.2689 2.2689"/>
          <geom mesh="link_2" material="linkgray" class="visual"/>
          <geom mesh="link_2" class="collision"/>
          <body name="link_3" pos="0 -0.256 0" quat="0.70710678 0.70710678 0 0">
            <inertial pos="3e-06 -0.01398 -0.011324" mass="1.11"
              fullinertia="0.001836663 0.001498875 0.001062545 2.259e-06 -4.216e-06 3.7167e-05"/>
            <joint name="joint_3" range="-3.106 3.106"/>
            <geom mesh="link_3" material="linkgray" class="visual"/>
            <geom mesh="link_3" class="collision"/>
            <body name="link_4" quat="0.70710678 -0.70710678 0 0">
              <inertial pos="-5e-06 -0.084658 0.004747" mass="0.685"
                fullinertia="0.001282444 0.000373013 0.001256177 -5.51e-07 -6.3e-07 -0.000232084"/>
              <joint name="joint_4" range="-2.356 2.356"/>
              <geom mesh="link_4" material="linkgray" class="visual"/>
              <geom mesh="link_4" class="collision"/>
              <body name="link_5" pos="0 -0.21 0" quat="0.70710678 0.70710678 0 0">
                <inertial pos="7.8e-05 -0.012937 -0.008781" mass="0.619"
                  fullinertia="0.000627336 0.000542455 0.000370291 1.636e-06 -1.345e-06 3.497e-05"/>
                <joint name="joint_5" range="-3.106 3.106"/>
                <geom mesh="link_5" material="linkgray" class="visual"/>
                <geom mesh="link_5" class="collision"/>
                <body name="link_6" quat="0.70710678 -0.70710678 0 0">
                  <inertial pos="-1.4e-05 -0.078524 0.002819" mass="0.602"
                    fullinertia="0.000780774 0.000289973 0.000763955 -1.21e-07 -4.69e-07 -0.000120513"/>
                  <joint name="joint_6" range="-2.234 2.234"/>
                  <geom mesh="link_6" material="linkgray" class="visual"/>
                  <geom mesh="link_6" class="collision"/>
                  <body name="link_7" pos="0 -0.144 0" quat="0.70710678 0.70710678 0 0">
                    <inertial pos="0.001094 -7.7e-05 -0.010119" mass="0.107"
                      fullinertia="4.4123e-05 3.5078e-05 6.5445e-05 -6.4e-08 3e-07 -2.9e-08"/>
                    <joint name="joint_7" range="-6.28 6.28"/>
                    <geom mesh="link_7" material="jointgray" class="visual"/>
                    <geom mesh="link_7" class="collision"/>
                    <site name="attachment_site"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- base_link is welded to the world, so MuJoCo's parent-child filter does not apply to it; its hull touches link_1's. -->
  <contact>
    <exclude body1="base_link" body2="link_1"/>
  </contact>

  <actuator>
    <general class="size3" name="joint_1" joint="joint_1" ctrlrange="-3.106 3.106"/>
    <general class="size3" name="joint_2" joint="joint_2" ctrlrange="-2.2689 2.2689"/>
    <general class="size3_limited" name="joint_3" joint="joint_3" ctrlrange="-3.106 3.106"/>
    <general class="size3_limited" name="joint_4" joint="joint_4" ctrlrange="-2.356 2.356"/>
    <general class="size1" name="joint_5" joint="joint_5" ctrlrange="-3.106 3.106"/>
    <general class="size1" name="joint_6" joint="joint_6" ctrlrange="-2.234 2.234"/>
    <general class="size1" name="joint_7" joint="joint_7" ctrlrange="-6.28 6.28"/>
  </actuator>
</mujoco>
