<mujoco model="eg2_4c2">
  <!--
    Inspire EG2-4C2 two-finger gripper + RealMan adapter plate, written as an edit of OGBench's robotiq_2f85/2f85.xml
    (MuJoCo Menagerie Robotiq 2F-85): same option, materials, default classes (driver, visual, collision, pad_box1),
    site pinch, tendon split and fingers_actuator (0..255 -> 0..0.8 rad); the linkage bodies, meshes and couplings
    are replaced by the vendor URDF's (github.com/RealManRobot/rm_models, thirdparty/Two-finger Electric Gripper).
    Body poses are the vendor poses at the fully open angle (0.82 rad): every hinge counts 0 = open .. 0.8 = closed.
    Mass = datasheet 231 g (the URDF's 73 g base is scaled up) + 40 g adapter.
  -->
  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <option cone="elliptic" impratio="10"/>

  <asset>
    <material name="metal" rgba="0.58 0.58 0.58 1"/>
    <material name="silicone" rgba="0.1882 0.1882 0.1882 1"/>
    <material name="gray" rgba="0.4627 0.4627 0.4627 1"/>
    <material name="black" rgba="0.149 0.149 0.149 1"/>
    <material name="pad_gray" rgba="0.5 0.5 0.5 1"/>

    <mesh class="eg2_4c2" file="baselink.stl"/>
    <mesh class="eg2_4c2" file="link1.stl"/>
    <mesh class="eg2_4c2" file="link2.stl"/>
    <mesh class="eg2_4c2" file="link3.stl"/>
    <mesh class="eg2_4c2" file="link4.stl"/>
    <mesh class="eg2_4c2" file="link5.stl"/>
    <mesh class="eg2_4c2" file="link6.stl"/>
  </asset>

  <default>
    <default class="eg2_4c2">
      <general biastype="affine"/>

      <joint axis="1 0 0"/>
      <default class="driver">
        <joint range="0 0.8" armature="0.005" damping="0.1" solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>

      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom type="mesh" group="3"/>
        <default class="pad_box1">
          <geom mass="0" type="box" pos="0 -0.0026 0.028125" size="0.011 0.004 0.009375" friction="0.7"
            solimp="0.95 0.99 0.001" solref="0.004 1" priority="1" rgba="0.55 0.55 0.55 1"/>
        </default>
        <default class="finger_box">
          <geom mass="0" type="box" rgba="0.45 0.45 0.45 1"/>
        </default>
      </default>
    </default>
  </default>

  <worldbody>
    <body name="base_mount" childclass="eg2_4c2">
      <inertial mass="0.04" pos="0 0 0.0059" diaginertia="1.0e-05 1.0e-05 1.6e-05"/>
      <geom class="visual" type="cylinder" size="0.0285 0.0059" pos="0 0 0.0059" material="metal"/>
      <geom class="collision" type="cylinder" size="0.0285 0.0059" pos="0 0 0.0059"/>
      <body name="base" pos="0 0 0.0118">
        <inertial mass="0.2095" pos="1.5645e-05 -4.1838e-06 0.038"
          fullinertia="0.00014694 0.00017558 5.5747e-05 -2.1101e-12 5.8337e-08 -1.3146e-08"/>
        <geom class="visual" mesh="baselink" material="black"/>
        <geom class="collision" mesh="baselink"/>
        <site name="pinch" pos="0 0 0.131" type="sphere" group="5" rgba="0.9 0.9 0.9 1" size="0.005"/>
        <!-- Left finger (vendor links 1, 5, 2): parallelogram outer link, fingertip, inner link -->
        <body name="left_driver" pos="-0.04 -0.009 0.079" quat="0.9171213 0 -0.3986093 0">
          <inertial mass="0.0024292" pos="0.0087669 0.009 0.013992"
            fullinertia="5.1061e-07 5.7398e-07 2.6747e-07 0 -2.508e-07 0"/>
          <joint name="left_driver_joint" class="driver" axis="0 1 0"/>
          <geom class="visual" mesh="link1" material="gray"/>
          <body name="left_pad" pos="0.0223 0.003 0.035591" quat="0.9171213 0 0.3986093 0">
            <inertial mass="0.0045068" pos="0.011864 0.006 0.011367"
              fullinertia="5.1288e-07 5.3203e-07 2.009e-07 0 -9.4703e-08 0"/>
            <joint name="left_pad_joint" class="driver" axis="0 -1 0"/>
            <geom class="visual" mesh="link5" material="pad_gray"/>
            <geom class="pad_box1" name="left_pad1" pos="0.0157 0.006 0.01175" size="0.002 0.009 0.01675"/>
            <geom class="finger_box" name="left_finger" pos="0.0051 0.006 0.01175" size="0.0086 0.009 0.01675"/>
          </body>
        </body>
        <body name="left_follower" pos="-0.03 -0.009 0.081" quat="0.9171213 0 -0.3986093 0">
          <inertial mass="0.0038971" pos="0.0087435 0.009 0.013955"
            fullinertia="5.6941e-07 6.2305e-07 3.0871e-07 0 -2.6891e-07 0"/>
          <joint name="left_follower_joint" class="driver" axis="0 1 0"/>
          <geom class="visual" mesh="link2" material="gray"/>
        </body>
        <!-- Right finger (vendor links 4, 6, 3) -->
        <body name="right_driver" pos="0.04 -0.009 0.079" quat="0.9171213 0 0.3986093 0">
          <inertial mass="0.0024292" pos="-0.0087669 0.009 0.013992"
            fullinertia="5.1061e-07 5.7398e-07 2.6747e-07 0 2.508e-07 0"/>
          <joint name="right_driver_joint" class="driver" axis="0 -1 0"/>
          <geom class="visual" mesh="link4" material="gray"/>
          <body name="right_pad" pos="-0.0223 0.003 0.035591" quat="0.9171213 0 -0.3986093 0">
            <inertial mass="0.0045068" pos="-0.011864 0.006 0.011367"
              fullinertia="5.1288e-07 5.3203e-07 2.009e-07 0 9.4703e-08 0"/>
            <joint name="right_pad_joint" class="driver" axis="0 1 0"/>
            <geom class="visual" mesh="link6" material="pad_gray"/>
            <geom class="pad_box1" name="right_pad1" pos="-0.0157 0.006 0.01175" size="0.002 0.009 0.01675"/>
            <geom class="finger_box" name="right_finger" pos="-0.0051 0.006 0.01175" size="0.0086 0.009 0.01675"/>
          </body>
        </body>
        <body name="right_follower" pos="0.03 -0.009 0.081" quat="0.9171213 0 0.3986093 0">
          <inertial mass="0.0038971" pos="-0.0087435 0.009 0.013955"
            fullinertia="5.6941e-07 6.2305e-07 3.0871e-07 0 2.6891e-07 0"/>
          <joint name="right_follower_joint" class="driver" axis="0 -1 0"/>
          <geom class="visual" mesh="link3" material="gray"/>
        </body>
      </body>
    </body>
  </worldbody>

  <!--
    This adds stability to the model by having a tendon that distributes the forces between both
    joints, such that the equality constraint doesn't have to do that much work in order to equalize
    both joints. Since both joints share the same sign, we split the force between both equally by
    setting coef=0.5
  -->
  <tendon>
    <fixed name="split">
      <joint joint="right_driver_joint" coef="0.5"/>
      <joint joint="left_driver_joint" coef="0.5"/>
    </fixed>
  </tendon>

  <!-- The URDF mimic tags: every hinge follows its driver; both drivers move together. -->
  <equality>
    <joint joint1="left_driver_joint" joint2="right_driver_joint" polycoef="0 1 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <joint joint1="left_pad_joint" joint2="left_driver_joint" polycoef="0 1 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <joint joint1="left_follower_joint" joint2="left_driver_joint" polycoef="0 1 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <joint joint1="right_pad_joint" joint2="right_driver_joint" polycoef="0 1 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <joint joint1="right_follower_joint" joint2="right_driver_joint" polycoef="0 1 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
  </equality>

  <!--
    The general actuator below is a customized position actuator (with some damping) where
    gainprm[0] != kp (see http://mujoco.org/book/modeling.html#position).
    The reason why gainprm[0] != kp is because the control input range has to be re-scaled to
    [0, 255]. The joint range is currently set at [0, 0.8], the control range is [0, 255] and
    kp = 100. Tau = Kp * scale * control_input - Kp * error, max(Kp * scale * control_input) = 0.8,
    hence scale = 0.8 * 100 / 255
    EG2-4C2: forcerange 1.7 on the tendon = 0.85 Nm per driver = ~20 N at the fingertips (datasheet max).
  -->
  <actuator>
    <general class="eg2_4c2" name="fingers_actuator" tendon="split" forcerange="-1.7 1.7" ctrlrange="0 255"
      gainprm="0.3137255 0 0" biasprm="0 -100 -10"/>
  </actuator>
</mujoco>
