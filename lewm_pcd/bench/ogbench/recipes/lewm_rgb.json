{
  "output_model_name": "lewm_rgb",
  "subdir": "lewm_rgb",
  "num_workers": 2,
  "validation_num_workers": 2,
  "seed": 0,
  "fresh_seed": 0,
  "img_size": 224,
  "embed_dim": 192,
  "pcd_in_dim": 6,
  "history_size": 3,
  "trainer": {
    "max_epochs": 10,
    "devices": 1,
    "accelerator": "gpu",
    "precision": "bf16-mixed",
    "gradient_clip_val": 1.0
  },
  "loader": {
    "batch_size": 128,
    "num_workers": 2,
    "persistent_workers": false,
    "prefetch_factor": 2,
    "pin_memory": true
  },
  "optimizer": {
    "type": "AdamW",
    "lr": 5e-05,
    "weight_decay": 0.001
  },
  "num_preds": 1,
  "loss": {
    "sigreg": {
      "weight": 0.09,
      "kwargs": {
        "knots": 17,
        "num_proj": 1024
      }
    }
  },
  "wandb": {
    "enabled": false
  },
  "data": {
    "preprocessor": {
      "_target_": "utils.get_img_preprocessor",
      "source": "pixels",
      "target": "pixels",
      "img_size": 224
    }
  },
  "model": {
    "_target_": "jepa.JEPA",
    "obs_key": "pixels",
    "encoder": {
      "_target_": "encoders.ViTCLS",
      "size": "tiny",
      "patch_size": 14,
      "image_size": 224,
      "pretrained": false,
      "use_mask_token": false
    },
    "predictor": {
      "_target_": "module.ARPredictor",
      "num_frames": 3,
      "input_dim": 192,
      "hidden_dim": 192,
      "output_dim": 192,
      "depth": 6,
      "heads": 16,
      "mlp_dim": 2048,
      "dim_head": 64,
      "dropout": 0.1,
      "emb_dropout": 0.0
    },
    "action_encoder": {
      "_target_": "module.Embedder",
      "input_dim": 25,
      "emb_dim": 192
    },
    "projector": {
      "_target_": "module.MLP",
      "input_dim": 192,
      "output_dim": 192,
      "hidden_dim": 2048,
      "norm_fn": {
        "_target_": "torch.nn.BatchNorm1d",
        "_partial_": true
      }
    },
    "pred_proj": {
      "_target_": "module.MLP",
      "input_dim": 192,
      "output_dim": 192,
      "hidden_dim": 2048,
      "norm_fn": {
        "_target_": "torch.nn.BatchNorm1d",
        "_partial_": true
      }
    }
  }
}
